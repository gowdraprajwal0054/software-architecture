{
  "info": {
    "name": "SMS Template 2 API Collection",
    "description": "Postman collection covering Auth, Student, Professor, Course, Enrollment, and Grade microservices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authServiceUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "professorServiceUrl",
      "value": "http://localhost:5002"
    },
    {
      "key": "studentServiceUrl",
      "value": "http://localhost:5003"
    },
    {
      "key": "courseServiceUrl",
      "value": "http://localhost:5004"
    },
    {
      "key": "enrollmentServiceUrl",
      "value": "http://localhost:5005"
    },
    {
      "key": "gradeServiceUrl",
      "value": "http://localhost:5006"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Login as Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{authServiceUrl}}/api/login/student",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "login",
                "student"
              ]
            }
          }
        },
        {
          "name": "Login as Professor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"professor@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{authServiceUrl}}/api/login/professor",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                "api",
                "login",
                "professor"
              ]
            }
          }
        },
        {
          "name": "Fetch JWKS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{authServiceUrl}}/.well-known/jwks.json",
              "host": [
                "{{authServiceUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Student Service",
      "item": [
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
